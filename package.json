{
  "name": "streamdeck-mic-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:helper && npm run build:plugin",
    "build:plugin": "rollup -c",
    "build:helper": "scripts/build-helper.sh",
    "icons": "node scripts/make-icons.ts",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart io.github.marvin-bay.miccontrol\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "link": "streamdeck link io.github.marvin-bay.miccontrol.sdPlugin",
    "restart": "streamdeck restart io.github.marvin-bay.miccontrol",
    "validate": "streamdeck validate io.github.marvin-bay.miccontrol.sdPlugin",
    "pack": "npm run build && streamdeck pack io.github.marvin-bay.miccontrol.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^22.20.5",
    "rollup": "^4.68.4",
    "tslib": "^2.9.1",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "description": "Stream Deck plugin: mute and adjust any microphone on macOS, with a level ring on the key.",
  "license": "MIT",
  "author": "Marvin Bay",
  "repository": {
    "type": "git",
    "url": "https://github.com/marvin-bay/streamdeck-mic-control.git"
  }
}
